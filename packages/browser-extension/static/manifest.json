{
  "manifest_version": 3,
  "name": "KOS",
  "version": "0.1.0",
  "description": "Lets KOS work in tabs you give it, in your own Chrome, while you watch.",
  "minimum_chrome_version": "137",
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "KOS", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
