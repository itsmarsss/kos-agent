{
  "manifest_version": 3,
  "name": "KOS",
  "version": "0.1.0",
  "description": "Lets KOS work in tabs you give it, in your own Chrome, while you watch, and talk with you beside them.",
  "minimum_chrome_version": "137",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KOS",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
