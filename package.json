{
  "name": "kos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kos": "./packages/cli/dist/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "kos": "node packages/cli/dist/main.js",
    "start": "node packages/cli/dist/main.js start",
    "stop": "node packages/cli/dist/main.js stop",
    "restart": "node packages/cli/dist/main.js restart",
    "chat": "node packages/cli/dist/main.js chat",
    "serve": "node packages/cli/dist/main.js serve",
    "doctor": "node packages/cli/dist/main.js doctor",
    "build:ui": "pnpm -C packages/ui build",
    "build:all": "pnpm build && pnpm build:ui"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
