# KOS harness secrets. Copy to .env (gitignored). The model never sees these;
# the harness injects them at call time and redacts them from logs.
# The kos CLI loads this file automatically from the repo root or cwd.

# Model providers (at least one needed for chat turns)
# Anthropic is preferred when both are set; OpenAI-only .env also works.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Your own model, a local server, or a gateway: any OpenAI-compatible endpoint.
# The base URL (also settable in Settings > Models) and, if it wants one, a key.
# KOS_CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
# KOS_SECRET_CUSTOM=
# A classifier (a "which of these" model such as Jev): POSTed {kind, question, text, labels}
# as JSON, answers {label, confidence}. Also settable in Settings > Models.
# KOS_CLASSIFIER_URL=
# KOS_SECRET_CLASSIFIER=

# Embeddings for semantic (episodic) memory. OpenAI is used when its key is
# present, else Cohere. With neither, episodic recall degrades to lexical
# hashing: it runs, but it is not semantic. Anthropic does not serve embeddings.
KOS_SECRET_COHERE=

# Discord channel (for: kos discord)
# Preferred names:
KOS_SECRET_DISCORD=
KOS_OWNER_DISCORD=
# Also accepted: DISCORD_TOKEN, DISCORD_BOT_TOKEN, DISCORD_OWNER_ID

# iMessage (macOS): your own handle. KOS reads your note-to-self thread only.
# KOS_OWNER_IMESSAGE=

# Any other integration key is exposed to the agent as secret "<name>"
# (lowercased) via this prefix, e.g. KOS_SECRET_STRIPE -> {{secret:stripe}}
# KOS_SECRET_STRIPE=

# Workspace location (defaults to ~/kos-workspace)
# KOS_WORKSPACE=/path/to/kos-workspace

# Dashboard (defaults: host 127.0.0.1, port 4317)
# KOS_PORT=4317
# KOS_HOST=127.0.0.1
# Optional bearer token for every dashboard API route
# KOS_DASHBOARD_TOKEN=
# Lets an outside service start a job by name: POST /api/hooks/<job name>
# with Authorization: Bearer <this>. Hooks are off until it is set.
# KOS_HOOK_SECRET=
# Optional path to built UI (default: packages/ui/dist after pnpm build:ui)
# KOS_UI_DIST=

# http.fetch allowlist (comma-separated hostnames)
# KOS_ALLOWED_HOSTS=api.github.com,api.openai.com
