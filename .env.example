# KOS harness secrets. Copy to .env (gitignored). The model never sees these;
# the harness injects them at call time and redacts them from logs.
# The kos CLI loads this file automatically from the repo root or cwd.

# Model providers (at least one needed for chat turns)
# Anthropic is preferred when both are set; OpenAI-only .env also works.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Discord channel (for: kos discord)
# Preferred names:
KOS_SECRET_DISCORD=
KOS_OWNER_DISCORD=
# Also accepted: DISCORD_TOKEN, DISCORD_BOT_TOKEN, DISCORD_OWNER_ID

# Any other integration key is exposed to the agent as secret "<name>"
# (lowercased) via this prefix, e.g. KOS_SECRET_STRIPE -> {{secret:stripe}}
# KOS_SECRET_STRIPE=

# Workspace location (defaults to ~/kos-workspace)
# KOS_WORKSPACE=/path/to/kos-workspace

# Dashboard (defaults: host 127.0.0.1, port 4317)
# KOS_PORT=4317
# KOS_HOST=127.0.0.1
# Optional bearer token for mutating dashboard API routes
# KOS_DASHBOARD_TOKEN=
# Optional path to built UI (default: packages/ui/dist after pnpm build:ui)
# KOS_UI_DIST=

# http.fetch allowlist (comma-separated hostnames)
# KOS_ALLOWED_HOSTS=api.github.com,api.openai.com
